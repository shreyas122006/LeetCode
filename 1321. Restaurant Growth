# Write your MySQL query statement below
SELECT visited_on, 
ROUND(( 
    SELECT SUM(amount) 
    FROM Customer WHERE visited_on BETWEEN date_sub(C.visited_on,interval 6 day) and C.visited_on
),2)
AS amount,
ROUND((
    SELECT SUM(amount)/7
    FROM Customer WHERE visited_on BETWEEN date_sub(C.visited_on,interval 6 day) and C.visited_on
),2) 
AS average_amount 
FROM Customer C
WHERE visited_on >= (
    SELECT date_add(min(visited_on),interval 6 day)
    FROM Customer
)
GROUP BY visited_on
ORDER BY visited_on
