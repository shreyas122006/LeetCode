class Solution {
    public int maximumCount(int[] nums) {
        // int countPos = 0;
        // int countNeg = 0;
        // for(int i=0; i<nums.length; i++) {
        //     if(nums[i]<0) {
        //         countNeg++;
        //     } 
        //     if(nums[i]>0) {
        //         countPos++;
        //     } 
        // }
        // return Math.max(countPos,countNeg);

        int n = nums.length;
        int left = 0;
        int right = n - 1;
        while (left <= right) {
            int mid = left + (right - left) / 2;
            if (nums[mid] >= 0) {
                right = mid - 1;
            } else {
                left = mid + 1;
            }
        }
        int countNeg = left;
        left = 0;
        right = n - 1;
        while (left <= right) {
            int mid = left + (right - left) / 2;
            if (nums[mid] > 0) {
                right = mid - 1;
            } else {
                left = mid + 1;
            }
        }
        int countPos = n - left;
        return Math.max(countNeg, countPos);
    }
}
