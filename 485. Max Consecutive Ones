class Solution {
    public int findMaxConsecutiveOnes(int[] nums) {
        int count = 0;
        int ans = 0;
       for(int i=0; i<nums.length; i++) {
            if(nums[i] == 0) {
                ans = 0;
            } else {
                ++ans;
            }
            count = Math.max(count,ans);
       }
       return count;
    }
}
