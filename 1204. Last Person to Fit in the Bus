-- SELECT Q1.person_name 
-- FROM Queue Q1
-- INNER JOIN Queue Q2 
-- ON Q1.turn >= Q2.turn
-- GROUP BY Q1.turn
-- HAVING SUM(Q2.weight) <= 1000
-- ORDER BY Q1.turn DESC LIMIT 1
SELECT person_name
FROM (
    SELECT person_name,
           SUM(weight) OVER (ORDER BY turn) AS running_weight
    FROM Queue
) T
WHERE running_weight <= 1000
ORDER BY running_weight DESC
LIMIT 1;
