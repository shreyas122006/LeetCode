class Solution {
    public int maxPower(String s) {
        int maxLen = 1;
        int ans = 1;
        for(int i=s.length()-1; i>=1; i--) {
            if(s.charAt(i) == s.charAt(i-1)) {
                ++ans;
            } else {
                ans = 1;
            }
            maxLen = Math.max(maxLen,ans);
        }
        return maxLen;
    }
}
