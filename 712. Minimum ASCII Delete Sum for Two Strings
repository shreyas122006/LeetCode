class Solution {
    public int minimumDeleteSum(String s1, String s2) {
        int n = s1.length();
        int m = s2.length();
        int dp[][] = new int[n+1][m+1];
        for(int i=1; i<dp.length; i++) {
            dp[i][0] = dp[i-1][0] + s1.charAt(i-1); // String 2 is empty //delete all from s1
        }
        for(int j=1; j<dp[0].length; j++) {
            dp[0][j] = dp[0][j-1] + s2.charAt(j-1); // String 1 is empty //delete all from s2
        }        
        for(int i=1; i<n+1; i++) {
            for(int j=1; j<m+1; j++) {
                if(s1.charAt(i-1) == s2.charAt(j-1)) {
                    dp[i][j] = dp[i-1][j-1];
                } else {
                    dp[i][j] = Math.min(dp[i][j-1]+s2.charAt(j-1),dp[i-1][j]+s1.charAt(i-1));
                }
            }
        }
        return dp[n][m];
    }
}
